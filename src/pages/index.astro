---
import Layout from '../layouts/Layout.astro';

const solidSeries = [
  {
    id: 'srp',
    title: 'Single Responsibility',
    letter: 'S',
    count: 7,
    summary: 'Seven extractions for fat models and fat controllers. Service, form, query, policy, decorator, concern, and value objects.',
    lessons: [
      { slug: 'senior-srp-service-objects',  emoji: '⚙️', label: 'Service Objects' },
      { slug: 'senior-srp-form-objects',     emoji: '📋', label: 'Form Objects' },
      { slug: 'senior-srp-query-objects',    emoji: '🔍', label: 'Query Objects' },
      { slug: 'senior-srp-policy-objects',   emoji: '🚦', label: 'Policy Objects' },
      { slug: 'senior-srp-decorators',       emoji: '🎨', label: 'Decorators' },
      { slug: 'senior-srp-concerns',         emoji: '🧩', label: 'Concerns' },
      { slug: 'senior-srp-value-objects',    emoji: '💎', label: 'Value Objects' },
    ],
  },
  {
    id: 'ocp',
    title: 'Open/Closed',
    letter: 'O',
    count: 5,
    summary: 'Five shapes for adding behavior without modifying existing code. Registry, adapter, middleware, pub-sub, delegated_type.',
    lessons: [
      { slug: 'senior-ocp-registry',         emoji: '🗂️', label: 'Registry' },
      { slug: 'senior-ocp-adapter',          emoji: '🔌', label: 'Adapter' },
      { slug: 'senior-ocp-middleware',       emoji: '🔗', label: 'Middleware' },
      { slug: 'senior-ocp-pub-sub',          emoji: '📣', label: 'Pub-Sub' },
      { slug: 'senior-ocp-delegated-type',   emoji: '🧬', label: 'delegated_type' },
    ],
  },
  {
    id: 'lsp',
    title: 'Liskov Substitution',
    letter: 'L',
    count: 2,
    summary: "Duck typing as Ruby's native idiom for substitutability, and where inheritance breaks the contract.",
    lessons: [
      { slug: 'senior-lsp-duck-typing',       emoji: '🪞', label: 'Duck Typing' },
      { slug: 'senior-lsp-contract-breaking', emoji: '🪞', label: 'Contract Breaking' },
    ],
  },
  {
    id: 'isp',
    title: 'Interface Segregation',
    letter: 'I',
    count: 2,
    summary: 'Focused concerns over fat mixins, and role-based interfaces over class-based dispatch.',
    lessons: [
      { slug: 'senior-isp-focused-concerns', emoji: '✂️', label: 'Focused Concerns' },
      { slug: 'senior-isp-role-interfaces',  emoji: '✂️', label: 'Role Interfaces' },
    ],
  },
  {
    id: 'dip',
    title: 'Dependency Inversion',
    letter: 'D',
    count: 3,
    summary: 'Inject collaborators, centralize configuration, and let the test environment swap dependencies cleanly.',
    lessons: [
      { slug: 'senior-dip-dependency-injection', emoji: '🔁', label: 'Dependency Injection' },
      { slug: 'senior-dip-config-injection',     emoji: '🔁', label: 'Config Injection' },
      { slug: 'senior-dip-test-seams',           emoji: '🔁', label: 'Test Seams' },
    ],
  },
];

const otherLessons = [
  { slug: 'senior-eager-loading',         title: 'Eager Loading — includes vs preload vs eager_load vs joins' },
  { slug: 'senior-open-closed-payouts',   title: 'Open/Closed in Practice — Gumroad payout system (long-form)' },
  { slug: 'senior-open-closed-payouts-2', title: 'Open/Closed in Practice — invented examples' },
  { slug: 'senior-glossary',              title: 'Senior Track Glossary' },
];
---

<Layout title="Home" description="The Senior Track for Rails developers leveling up from mid to senior. SOLID principles in real OSS code, Spot the Tax cards, and the design judgment that separates intermediate from senior.">
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-3">RailsFullStack</p>
      <h1 class="text-5xl font-bold text-gray-900 mb-4">Senior Track</h1>
      <p class="text-xl text-gray-600 max-w-2xl">
        The gap from intermediate to senior Rails developer is not more syntax. It is design judgment, calibration, and the ability to defend technical decisions. <strong class="text-gray-900">This track closes that gap, anchored in real production Rails code.</strong>
      </p>
    </div>
  </section>

  <section id="solid" class="max-w-4xl mx-auto px-6 py-12 space-y-8">
    <div>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">SOLID in Real Rails Code</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">The five principles, 19 lessons</h2>
      <p class="text-gray-700 max-w-2xl">
        Each principle anchored in source code from Mastodon, Forem, Discourse, Gumroad, and Rails core. The lessons trace the rule back to where it came from, name the anti-pattern with a concrete scenario, and walk through how a senior codebase actually applies it.
      </p>
    </div>

    <div class="grid gap-5">
      {solidSeries.map((series) => (
        <article class="bg-white rounded-lg border border-gray-200 p-6">
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-baseline gap-4">
              <span class="text-5xl font-bold text-ruby leading-none">{series.letter}</span>
              <div>
                <h3 class="text-xl font-bold text-gray-900">{series.title}</h3>
                <p class="text-sm text-gray-500">{series.count} lessons</p>
              </div>
            </div>
          </div>
          <p class="text-gray-700 mb-5">{series.summary}</p>
          <ul class="grid gap-2 sm:grid-cols-2">
            {series.lessons.map((lesson, i) => (
              <li>
                <a href={`/lessons/${lesson.slug}`} class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
                  <span class="text-xl" aria-hidden="true">{lesson.emoji}</span>
                  <span class="text-sm text-gray-500 w-6 tabular-nums">{i + 1}.</span>
                  <span class="text-gray-700 group-hover:text-ruby transition-colors">{lesson.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section id="spot-the-tax" class="max-w-4xl mx-auto px-6 py-12 space-y-6">
    <div>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Spot the Tax</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">20 cards · code that ships, costs that compound</h2>
      <p class="text-gray-700 max-w-2xl">
        Each card shows a piece of Rails code that works today but will cost something specific in six months. Read the code, predict the cost, reveal the principle. Faster than a lesson, sharper than a tutorial.
      </p>
    </div>
    <a href="/lessons/spot-the-tax" class="inline-flex items-center gap-2 px-5 py-3 bg-ruby text-white rounded-lg hover:bg-ruby-dark transition-colors font-medium">
      Browse all 20 cards →
    </a>
  </section>

  <section id="practice" class="max-w-4xl mx-auto px-6 py-12 space-y-6">
    <div>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Practice</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Drill the theory until it sticks</h2>
      <p class="text-gray-700 max-w-2xl">
        Short problem→reveal cards built from the long-form lessons. Read a snippet, form an answer in your head, then reveal what's happening and why. Same shape as Spot the Tax, applied to the Reading the Source series. More categories coming.
      </p>
    </div>
    <article class="bg-white rounded-lg border border-gray-200 p-6">
      <p class="text-sm text-gray-500 mb-4 uppercase tracking-wider font-semibold">Reading the Source · 5 cards</p>
      <ul class="grid gap-2 sm:grid-cols-2">
        <li>
          <a href="/lessons/practice-source-belongs-to-optional" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🔗</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">1.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">What <code class="text-sm">optional: true</code> actually changes</span>
          </a>
        </li>
        <li>
          <a href="/lessons/practice-source-when-sql-runs" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🔎</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">2.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Which line actually runs the SQL?</span>
          </a>
        </li>
        <li>
          <a href="/lessons/practice-source-require-vs-bracket" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">📥</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">3.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors"><code class="text-sm">require</code> vs <code class="text-sm">[]</code> failure modes</span>
          </a>
        </li>
        <li>
          <a href="/lessons/practice-source-before-action-halt" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">⛔</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">4.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Why is the unauthorized user still through?</span>
          </a>
        </li>
        <li>
          <a href="/lessons/practice-source-raw-form-missing" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">📝</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">5.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">What's missing from this hand-written form?</span>
          </a>
        </li>
      </ul>
    </article>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 space-y-6">
    <div>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Other Senior Track lessons</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Long-form and reference</h2>
    </div>
    <ul class="space-y-3">
      {otherLessons.map((lesson) => (
        <li>
          <a href={`/lessons/${lesson.slug}`} class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-ruby transition-colors group">
            <h3 class="font-semibold text-gray-900 group-hover:text-ruby transition-colors">{lesson.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="reading-the-source" class="max-w-4xl mx-auto px-6 py-12 space-y-6">
    <div>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Reading the Source</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Plain-language walkthroughs of how Rails actually works</h2>
      <p class="text-gray-700 max-w-2xl">
        Each lesson takes one core Rails feature and walks through what the framework is actually doing, in six short steps. Junior-friendly words, real Ruby code, and file paths into the Rails source so you can keep digging.
      </p>
    </div>
    <article class="bg-white rounded-lg border border-gray-200 p-6">
      <ul class="grid gap-2 sm:grid-cols-2">
        <li>
          <a href="/lessons/source-belongs-to" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🔗</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">1.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">What <code class="text-sm">belongs_to :user</code> actually adds</span>
          </a>
        </li>
        <li>
          <a href="/lessons/source-routing" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🛤️</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">2.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">How <code class="text-sm">get "/posts"</code> becomes a controller call</span>
          </a>
        </li>
        <li>
          <a href="/lessons/source-activerecord-query" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🔎</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">3.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">How <code class="text-sm">User.where(...)</code> becomes SQL</span>
          </a>
        </li>
        <li>
          <a href="/lessons/source-view-rendering" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🖼️</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">4.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">How a view gets rendered after your action</span>
          </a>
        </li>
        <li>
          <a href="/lessons/source-params" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">📥</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">5.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">How <code class="text-sm">params</code> works (and what <code class="text-sm">permit</code> does)</span>
          </a>
        </li>
        <li>
          <a href="/lessons/source-before-action" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">⛓️</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">6.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">How <code class="text-sm">before_action</code> chains run</span>
          </a>
        </li>
        <li>
          <a href="/lessons/source-form-with" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">📝</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">7.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">How <code class="text-sm">form_with</code> builds an HTML form</span>
          </a>
        </li>
      </ul>
    </article>
  </section>

  <section id="scaling" class="max-w-4xl mx-auto px-6 py-12 space-y-6">
    <div>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Scaling Rails Apps</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">8 lessons · the bottleneck moves, your tools do not</h2>
      <p class="text-gray-700 max-w-2xl">
        Most "we need to scale!" conversations are three different problems pretending to be one. This series builds the diagnostic muscle: where the bottleneck actually lives, the order to fix things in, and the engineering blogs from Shopify, GitHub, and Artsy that document how real teams found theirs.
      </p>
    </div>
    <article class="bg-white rounded-lg border border-gray-200 p-6">
      <p class="text-gray-700 mb-5">All 8 lessons published.</p>
      <ul class="grid gap-2 sm:grid-cols-2">
        <li>
          <a href="/lessons/senior-scaling-diagnose" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🩺</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">1.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Diagnose Before You Scale</span>
          </a>
        </li>
        <li>
          <a href="/lessons/senior-scaling-indexes" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">📇</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">2.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Indexes &amp; EXPLAIN</span>
          </a>
        </li>
        <li>
          <a href="/lessons/senior-scaling-concurrency" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🧵</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">3.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">The Concurrency Model</span>
          </a>
        </li>
        <li>
          <a href="/lessons/senior-scaling-hot-rows" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🔥</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">4.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Hot Rows &amp; Contention</span>
          </a>
        </li>
        <li>
          <a href="/lessons/senior-scaling-caching" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">🗄️</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">5.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Caching, Properly</span>
          </a>
        </li>
        <li>
          <a href="/lessons/senior-scaling-background-jobs" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">⏱️</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">6.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Background Jobs as a Scaling Tool</span>
          </a>
        </li>
        <li>
          <a href="/lessons/senior-scaling-pagination" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">📑</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">7.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Pagination at Scale</span>
          </a>
        </li>
        <li>
          <a href="/lessons/senior-scaling-bulk-operations" class="flex items-center gap-3 px-3 py-2 rounded-md hover:bg-gray-50 transition-colors group">
            <span class="text-xl" aria-hidden="true">📦</span>
            <span class="text-sm text-gray-500 w-6 tabular-nums">8.</span>
            <span class="text-gray-700 group-hover:text-ruby transition-colors">Bulk Operations &amp; Memory</span>
          </a>
        </li>
      </ul>
    </article>
  </section>
</Layout>
