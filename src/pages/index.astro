---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';

const hubs = [
  {
    href: '/practice',
    title: 'Practice',
    summary: 'Short problem→reveal cards across six categories. Spot the Tax, Reading the Source, Scaling, SOLID, Payments, and Interview Prep. Commit to an answer before any explanation appears.',
    pill: '55 cards',
    icon: 'lucide:target',
  },
  {
    href: '/reading-the-source',
    title: 'Rails source code',
    summary: 'Plain-language walkthroughs of how Rails actually works. Twelve lessons covering routing, queries, rendering, params, callbacks, forms, and the model declarations you use every day.',
    pill: '12 lessons',
    icon: 'lucide:search',
  },
  {
    href: '/solid',
    title: 'SOLID in Real Rails Code',
    summary: 'The five SOLID principles, 19 lessons. Each anchored in production code from Mastodon, Forem, Discourse, Gumroad, and Rails core.',
    pill: '19 lessons',
    icon: 'lucide:puzzle',
  },
  {
    href: '/scaling',
    title: 'Scaling Rails Apps',
    summary: 'Eight lessons on diagnosing and fixing the bottlenecks every Rails team hits. Where the bottleneck actually lives, the order to fix things in.',
    pill: '8 lessons',
    icon: 'lucide:trending-up',
  },
  {
    href: '/payments',
    title: 'Handling Payments',
    summary: 'Six lessons on building payments into a Rails app the way real teams do it: payment intents, idempotency, webhooks, async confirmation, refunds, and the ledger pattern.',
    pill: '6 lessons',
    icon: 'lucide:credit-card',
  },
  {
    href: '/interview',
    title: 'Interview Prep',
    summary: 'How senior Rails interviews actually work, system-design framing, behavioral stories, and the modern-stack questions (Solid Queue, Hotwire, Kamal) interviewers ask in 2026.',
    pill: '4 lessons',
    icon: 'lucide:mic',
  },
  {
    href: '/hotwire',
    title: 'Hotwire in Real Rails Code',
    summary: "Where the senior gap lives in modern Rails frontends. Turbo Streams vs Broadcasts, lazy Frames, Stimulus boundaries, Rails 8 morphing, and the honest call on when to graduate to a real framework.",
    pill: '6 lessons',
    icon: 'lucide:zap',
  },
];
---

<Layout title="Home" description="The Senior Track for Rails developers leveling up from mid to senior. SOLID, Scaling, Reading the Source, Payments, Interview Prep, plus 55 Practice drill cards. Anchored in real production Rails code.">
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-16">
      <a href="https://railsfullstack.com" class="inline-flex items-center gap-2 text-sm uppercase tracking-wider text-gray-500 hover:text-gum-pink font-semibold mb-4 transition-colors">
        <span aria-hidden="true">←</span> railsfullstack.com
      </a>
      <h1 class="text-5xl font-bold text-gray-900 mb-4 tracking-tight">
        rails<span class="text-gum-pink">/</span>fullstack <span class="text-gray-400 font-normal">/ learn</span>
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl">
        A few written pieces on common Ruby on Rails patterns and senior mindsets. By the team behind <a href="https://railsfullstack.com" class="text-gum-pink hover:underline font-semibold">railsfullstack.com</a>.
      </p>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-12 space-y-6">
    <div>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Pick a track</h2>
      <p class="text-gray-700 max-w-2xl">Each section has its own landing page with the full list of lessons. Theory teaches the shape; Practice makes it stick.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {hubs.map((hub) => (
        <a href={hub.href} class="block bg-white rounded-lg border border-gray-200 p-6 hover:border-ruby/40 hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <Icon name={hub.icon} class="w-10 h-10 inline-block" aria-hidden="true" />
            <div class="flex-1">
              <div class="flex items-baseline justify-between mb-2">
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-ruby-dark transition-colors">{hub.title}</h3>
                <span class="text-sm text-gray-500">{hub.pill}</span>
              </div>
              <p class="text-gray-700 leading-relaxed">{hub.summary}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 py-12">
    <a href="/lessons/senior-glossary" class="block bg-white rounded-lg border border-gray-200 p-6 hover:border-ruby/40 hover:shadow-md transition-all group">
      <div class="flex items-center gap-4">
        <Icon name="lucide:book-open" class="w-8 h-8 inline-block" aria-hidden="true" />
        <div class="flex-1">
          <h3 class="text-lg font-bold text-gray-900 group-hover:text-ruby-dark transition-colors">Senior Track Glossary</h3>
          <p class="text-gray-700 mt-1">Plain-language definitions of the vocabulary that comes up across the lessons. One stop for the terms that keep showing up.</p>
        </div>
      </div>
    </a>
  </section>
</Layout>
