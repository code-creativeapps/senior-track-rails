---
import Layout from '../layouts/Layout.astro';

const hubs = [
  {
    href: '/practice',
    title: 'Practice',
    summary: 'Short problem→reveal cards across four categories. Spot the Tax, Reading the Source, Scaling, and SOLID. Commit to an answer before any explanation appears.',
    pill: '43 cards',
    emoji: '🎯',
  },
  {
    href: '/reading-the-source',
    title: 'Reading the Source',
    summary: 'Plain-language walkthroughs of how Rails actually works. Twelve lessons covering routing, queries, rendering, params, callbacks, forms, and the model declarations you use every day.',
    pill: '12 lessons',
    emoji: '🔎',
  },
  {
    href: '/solid',
    title: 'SOLID in Real Rails Code',
    summary: 'The five SOLID principles, 19 lessons. Each anchored in production code from Mastodon, Forem, Discourse, Gumroad, and Rails core.',
    pill: '19 lessons',
    emoji: '🧩',
  },
  {
    href: '/scaling',
    title: 'Scaling Rails Apps',
    summary: 'Eight lessons on diagnosing and fixing the bottlenecks every Rails team hits. Where the bottleneck actually lives, the order to fix things in.',
    pill: '8 lessons',
    emoji: '📈',
  },
];

const otherLessons = [
  { slug: 'senior-eager-loading',         title: 'Eager Loading — includes vs preload vs eager_load vs joins' },
  { slug: 'senior-open-closed-payouts',   title: 'Open/Closed in Practice — Gumroad payout system (long-form)' },
  { slug: 'senior-open-closed-payouts-2', title: 'Open/Closed in Practice — invented examples' },
  { slug: 'senior-glossary',              title: 'Senior Track Glossary' },
];
---

<Layout title="Home" description="The Senior Track for Rails developers leveling up from mid to senior. SOLID, Scaling, Reading the Source, plus 43 Practice drill cards. Anchored in real production Rails code.">
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-4xl mx-auto px-6 py-16">
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-3">RailsFullStack</p>
      <h1 class="text-5xl font-bold text-gray-900 mb-4">Senior Track</h1>
      <p class="text-xl text-gray-600 max-w-2xl">
        The gap from intermediate to senior Rails developer isn't more syntax. It's design judgment, calibration, and the ability to defend technical decisions. <strong class="text-gray-900">This track closes that gap, anchored in real production Rails code.</strong>
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 space-y-6">
    <div>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Pick a track</h2>
      <p class="text-gray-700 max-w-2xl">Each section has its own landing page with the full list of lessons. Theory teaches the shape; Practice makes it stick.</p>
    </div>
    <div class="grid gap-5">
      {hubs.map((hub) => (
        <a href={hub.href} class="block bg-white rounded-lg border border-gray-200 p-6 hover:border-ruby/40 hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <span class="text-4xl" aria-hidden="true">{hub.emoji}</span>
            <div class="flex-1">
              <div class="flex items-baseline justify-between mb-2">
                <h3 class="text-xl font-bold text-gray-900 group-hover:text-ruby-dark transition-colors">{hub.title}</h3>
                <span class="text-sm text-gray-500">{hub.pill}</span>
              </div>
              <p class="text-gray-700 leading-relaxed">{hub.summary}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 space-y-6">
    <div>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Other Senior Track lessons</p>
      <h2 class="text-3xl font-bold text-gray-900 mb-3">Long-form and reference</h2>
    </div>
    <ul class="space-y-3">
      {otherLessons.map((lesson) => (
        <li>
          <a href={`/lessons/${lesson.slug}`} class="block p-4 bg-white rounded-lg border border-gray-200 hover:border-ruby transition-colors group">
            <h3 class="font-semibold text-gray-900 group-hover:text-ruby transition-colors">{lesson.title}</h3>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
