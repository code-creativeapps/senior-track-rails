---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const drill = {
  title: 'Filter active users',
  difficulty: 'Junior',
  description: `Implement <code>active_users(users)</code>. Given an array of hashes where each hash has a <code>:name</code> and a <code>:active</code> key, return only the active ones, sorted alphabetically by name.`,
  starterCode: `# Implement this method:
def active_users(users)
  # your code here
end
`,
  tests: `require 'minitest'

class TestActiveUsers < Minitest::Test
  def test_returns_only_active
    users = [
      { name: "Karim", active: true  },
      { name: "Sara",  active: false },
      { name: "Bob",   active: true  },
    ]
    result = active_users(users)
    assert_equal 2, result.size
    assert result.all? { |u| u[:active] }, "expected all returned users to be active"
  end

  def test_sorts_alphabetically
    users = [
      { name: "Zoe",   active: true },
      { name: "Alice", active: true },
      { name: "Mike",  active: true },
    ]
    names = active_users(users).map { |u| u[:name] }
    assert_equal ["Alice", "Mike", "Zoe"], names
  end

  def test_empty_input
    assert_equal [], active_users([])
  end

  def test_all_inactive
    users = [{ name: "A", active: false }, { name: "B", active: false }]
    assert_equal [], active_users(users)
  end
end

# Manual run (we're not on the CLI, so we set the seed ourselves).
Minitest.seed = 0

passed = 0
failed = 0
TestActiveUsers.runnable_methods.each do |name|
  t = TestActiveUsers.new(name)
  t.run
  if t.failures.empty?
    passed += 1
    puts "  ✓ \#{name}"
  else
    failed += 1
    puts "  ✗ \#{name}"
    t.failures.each { |f| puts "      \#{f.message.lines.first.strip}" }
  end
end

puts
puts "\#{passed + failed} runs, \#{passed} passed, \#{failed} failed"
puts(failed.zero? ? "0 failures, 0 errors" : "FAIL")
`,
};
---

<Layout title="Drill — Filter Active Users" description="Proof of concept: write Ruby in your browser, run tests against it, see pass/fail. Powered by ruby.wasm.">
  <article class="max-w-7xl mx-auto px-6 py-12 space-y-6">
    <div>
      <a href="/" class="text-ruby hover:text-ruby-dark transition-colors inline-flex items-center gap-2 mb-6">
        <Icon name="lucide:arrow-left" class="w-4 h-4 inline-block" /> Back to Course
      </a>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Drill · Proof of Concept</p>
      <h1 class="text-4xl font-bold text-ruby-dark mb-4">{drill.title}</h1>
      <span class="inline-block px-2 py-0.5 text-xs font-semibold rounded bg-green-100 text-green-700 border border-green-300">{drill.difficulty}</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      <!-- Description pane -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 space-y-6">
        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Description</h3>
          <p class="text-gray-700 leading-relaxed" set:html={drill.description}></p>
        </div>

        <div>
          <h3 class="text-lg font-semibold text-gray-900 mb-3">Example</h3>
          <pre class="bg-gray-900 text-gray-100 rounded-lg p-4 text-sm overflow-x-auto"><code>{`active_users([
  { name: "Karim", active: true  },
  { name: "Sara",  active: false },
  { name: "Bob",   active: true  },
])
# => [
#      { name: "Bob",   active: true },
#      { name: "Karim", active: true },
#    ]`}</code></pre>
        </div>

        <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-sm text-gray-700">
          <p><strong>How this works:</strong> Your Ruby code runs in your own browser via ruby.wasm. No server, no submission. Click Run to test it, Submit to run the test suite.</p>
        </div>
      </div>

      <!-- Editor pane -->
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 bg-gray-50 border-b border-gray-200">
          <span class="text-sm font-medium text-gray-700">Ruby</span>
          <div id="status" class="text-xs text-gray-500">Loading Ruby…</div>
        </div>

        <textarea id="editor" spellcheck="false" class="w-full font-mono text-sm bg-gray-900 text-gray-100 p-4 border-0 focus:outline-none focus:ring-0 resize-none" style="min-height: 360px;" set:html={drill.starterCode}></textarea>

        <div class="flex items-center gap-2 px-4 py-3 bg-gray-50 border-t border-gray-200">
          <button id="run-btn" disabled class="px-4 py-2 bg-white border border-gray-300 rounded-md text-sm font-medium hover:bg-gray-100 disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-2">
            <Icon name="lucide:play" class="w-4 h-4" />
            Run
          </button>
          <button id="submit-btn" disabled class="px-4 py-2 bg-ruby text-white rounded-md text-sm font-medium hover:bg-ruby-dark disabled:opacity-50 disabled:cursor-not-allowed inline-flex items-center gap-2">
            <Icon name="lucide:check-check" class="w-4 h-4" />
            Submit
          </button>
        </div>

        <div class="border-t border-gray-200 bg-gray-900 text-gray-100 p-4 text-sm font-mono overflow-x-auto" style="min-height: 120px;">
          <pre id="output" class="whitespace-pre-wrap m-0">Click Run to execute your code, or Submit to run the tests.</pre>
        </div>
      </div>
    </div>

    <div class="flex justify-between items-center pt-4">
      <a href="/" class="text-ruby hover:text-ruby-dark transition-colors">← Back to Course</a>
      <span class="text-gray-400 text-sm">Drill POC · ruby.wasm in the browser</span>
    </div>
  </article>

  <script id="drill-data" type="application/json" set:html={JSON.stringify({ tests: drill.tests })}></script>

  <script>
    import { DefaultRubyVM } from "@ruby/wasm-wasi/dist/browser";

    const data = JSON.parse(document.getElementById('drill-data')!.textContent!);
    const statusEl = document.getElementById('status')!;
    const outputEl = document.getElementById('output')!;
    const editorEl = document.getElementById('editor') as HTMLTextAreaElement;
    const runBtn   = document.getElementById('run-btn') as HTMLButtonElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    // Load the WASM binary from /public.
    statusEl.textContent = "Loading Ruby (≈34MB, cached after first load)…";
    const wasmResp = await fetch("/ruby+stdlib.wasm");
    if (!wasmResp.ok) {
      statusEl.textContent = "Failed to fetch ruby+stdlib.wasm";
      throw new Error("wasm fetch failed");
    }
    const wasmModule = await WebAssembly.compileStreaming(wasmResp);
    const { vm } = await DefaultRubyVM(wasmModule);

    statusEl.innerHTML = '<span class="text-green-600 font-medium">Ruby ready ✓</span>';
    runBtn.disabled = false;
    submitBtn.disabled = false;

    function runRuby(code: string): string {
      try {
        const wrapped = `
          require 'stringio'
          orig = $stdout
          $stdout = StringIO.new
          begin
            ${code}
          rescue Exception => e
            $stdout.puts(\"\\n\#{e.class}: \#{e.message}\")
            $stdout.puts(e.backtrace.first(5).join(\"\\n\")) if e.backtrace
          ensure
            out = $stdout.string
            $stdout = orig
          end
          out
        `;
        const result = vm.eval(wrapped);
        return result.toString();
      } catch (err: any) {
        return `JS error: ${err && err.message ? err.message : err}`;
      }
    }

    runBtn.addEventListener("click", () => {
      outputEl.textContent = "Running…";
      const code = editorEl.value;
      const wrapped = `${code}

# Try it with the example:
result = active_users([
  { name: "Karim", active: true  },
  { name: "Sara",  active: false },
  { name: "Bob",   active: true  },
])
puts result.inspect`;
      const out = runRuby(wrapped);
      outputEl.textContent = out || "(no output)";
    });

    submitBtn.addEventListener("click", () => {
      outputEl.textContent = "Running tests…";
      const code = editorEl.value;
      const out = runRuby(`${code}\n\n${data.tests}`);
      const passed = /0 failures, 0 errors/i.test(out);
      outputEl.textContent = out + (passed ? "\n\n✓ All tests passed." : "\n\n✗ Some tests failed.");
    });
  </script>
</Layout>
