---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';

const lessons = [
  { slug: 'interview-approach',       icon: 'lucide:compass', label: 'How Senior Rails Interviews Actually Work', n: 1 },
  { slug: 'interview-system-design',  icon: 'lucide:building-2', label: 'System Design for Rails Interviews',       n: 2 },
  { slug: 'interview-behavioral',     icon: 'lucide:message-square', label: 'Behavioral Stories for Senior Roles',      n: 3 },
  { slug: 'interview-modern-stack',   icon: 'lucide:zap', label: 'The Modern Rails Stack (Rails 8+)',         n: 4 },
];
---

<Layout title="Interview Prep — Senior Track" description="Four lessons on the senior Rails interview: how it actually works, system design framing, behavioral stories, and the modern-stack questions interviewers ask in 2026.">
  <article class="max-w-7xl mx-auto px-6 py-12 space-y-8">
    <div>
      <a href="/" class="text-ruby hover:text-ruby-dark transition-colors inline-flex items-center gap-2 mb-6">
        <span>←</span> Back to Course
      </a>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Senior Track</p>
      <h1 class="text-4xl font-bold text-ruby-dark mb-4">Interview Prep</h1>
      <p class="text-xl text-gray-600 leading-relaxed">Most Rails interview prep teaches the syntax. Senior interviews don't test syntax. They test calibration, judgment, and how you defend technical decisions. These four lessons cover what interviewers are actually scoring on, then the practice cards drill the questions you'll get asked.</p>
    </div>

    <div class="grid gap-3">
      {lessons.map((lesson) => (
        <a href={`/lessons/${lesson.slug}`} class="flex items-center gap-4 bg-white rounded-lg border border-gray-200 p-4 hover:border-ruby/40 hover:shadow-sm transition-all group">
          <Icon name={lesson.icon} class="w-7 h-7 inline-block" aria-hidden="true" />
          <span class="text-sm text-gray-500 w-6 tabular-nums font-semibold">{lesson.n}.</span>
          <span class="text-gray-900 font-medium group-hover:text-ruby-dark transition-colors">{lesson.label}</span>
        </a>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
      <p class="text-sm text-gray-700 leading-relaxed">
        <strong>Want to drill the questions?</strong> The matching <a href="/practice/interview" class="text-ruby hover:text-ruby-dark font-medium">Practice cards</a> turn common interview questions into multiple-choice scenarios with answer rubrics.
      </p>
    </div>

    <div class="flex justify-between items-center pt-8 border-t border-gray-200">
      <a href="/" class="text-ruby hover:text-ruby-dark transition-colors">← Back to Course</a>
      <span class="text-gray-400 text-sm">Senior Track · Interview Prep · 4 lessons</span>
    </div>
  </article>
</Layout>
