---
import Layout from '../../layouts/Layout.astro';

const cards = [
  { slug: 'practice-source-belongs-to-optional', emoji: '🔗', title: 'What <code>optional: true</code> actually changes' },
  { slug: 'practice-source-when-sql-runs',       emoji: '🔎', title: 'Which line actually runs the SQL?' },
  { slug: 'practice-source-require-vs-bracket',  emoji: '📥', title: '<code>require</code> vs <code>[]</code> failure modes' },
  { slug: 'practice-source-before-action-halt',  emoji: '⛔', title: "Why is the unauthorized user still through?" },
  { slug: 'practice-source-raw-form-missing',    emoji: '📝', title: "What's missing from this hand-written form?" },
];
---

<Layout title="Reading the Source — Practice" description="Multiple-choice drills on how Rails actually works behind the magic. Discrete answers, wrong picks explain themselves.">
  <article class="max-w-7xl mx-auto px-6 py-12 space-y-8">
    <div>
      <a href="/practice" class="text-ruby hover:text-ruby-dark transition-colors inline-flex items-center gap-2 mb-6">
        <span>←</span> Back to Practice
      </a>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Practice · Reading the Source</p>
      <h1 class="text-4xl font-bold text-ruby-dark mb-4">Drill the framework's behavior</h1>
      <p class="text-xl text-gray-600 leading-relaxed">Multiple-choice cards on the parts of Rails most developers use daily without dissecting. Each card pairs with one of the long-form Reading the Source lessons.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {cards.map((card, i) => (
        <a href={`/lessons/${card.slug}`} class="block bg-white rounded-lg border border-gray-200 p-5 hover:border-ruby/40 hover:shadow-md transition-all group">
          <div class="flex items-start gap-3">
            <span class="text-2xl" aria-hidden="true">{card.emoji}</span>
            <div class="flex-1">
              <p class="text-xs text-gray-500 mb-1 uppercase tracking-wider font-semibold">Card {i + 1}</p>
              <h3 class="font-semibold text-gray-900 group-hover:text-ruby-dark transition-colors leading-snug" set:html={card.title}></h3>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
      <p class="text-sm text-gray-700 leading-relaxed">
        <strong>Want the theory?</strong> Each card ends with a pointer to its long-form lesson. The series itself lives at <a href="/reading-the-source" class="text-ruby hover:text-ruby-dark font-medium">Reading the Source</a>.
      </p>
    </div>

    <div class="flex justify-between items-center pt-8 border-t border-gray-200">
      <a href="/practice" class="text-ruby hover:text-ruby-dark transition-colors">← Back to Practice</a>
      <span class="text-gray-400 text-sm">Practice · Reading the Source · 5 cards</span>
    </div>
  </article>
</Layout>
