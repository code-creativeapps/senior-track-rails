---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';

const cards = [
  { slug: 'practice-scaling-index-choice',         icon: 'lucide:list-ordered', title: 'Which single index helps this query most?' },
  { slug: 'practice-scaling-n-plus-one-count',     icon: 'lucide:hash', title: 'Count the queries this view runs' },
  { slug: 'practice-scaling-cache-stampede',       icon: 'lucide:rabbit', title: 'Failure mode of this cache under high traffic' },
  { slug: 'practice-scaling-offset-pagination',    icon: 'lucide:bookmark', title: 'Why is page 50,000 so much slower?' },
  { slug: 'practice-scaling-hot-row-contention',   icon: 'lucide:flame', title: 'Why is the counter cache slowing down inserts?' },
  { slug: 'practice-scaling-concurrency-race',     icon: 'lucide:flag', title: "What's wrong with this counter increment?" },
  { slug: 'practice-scaling-background-jobs',      icon: 'lucide:timer', title: 'The signup is slow. What moves first?' },
  { slug: 'practice-scaling-bulk-operations',      icon: 'lucide:package', title: 'How many writes does this loop fire?' },
];
---

<Layout title="Scaling — Practice" description="Multiple-choice drills on the scaling-bug shapes every Rails team hits: N+1, indexes, caching, pagination, hot rows, concurrency, jobs, bulk operations.">
  <article class="max-w-7xl mx-auto px-6 py-12 space-y-8">
    <div>
      <a href="/practice" class="text-ruby hover:text-ruby-dark transition-colors inline-flex items-center gap-2 mb-6">
        <span>←</span> Back to Practice
      </a>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Practice · Scaling</p>
      <h1 class="text-4xl font-bold text-ruby-dark mb-4">Drill the scaling-bug shapes</h1>
      <p class="text-xl text-gray-600 leading-relaxed">One concrete scenario per card, four options to pick from. The wrong picks come with explanations — they're often the most valuable part. Pairs with the long-form Scaling series.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {cards.map((card, i) => (
        <a href={`/lessons/${card.slug}`} class="block bg-white rounded-lg border border-gray-200 p-5 hover:border-ruby/40 hover:shadow-md transition-all group">
          <div class="flex items-start gap-3">
            <Icon name={card.icon} class="w-7 h-7 inline-block" aria-hidden="true" />
            <div class="flex-1">
              <p class="text-xs text-gray-500 mb-1 uppercase tracking-wider font-semibold">Card {i + 1}</p>
              <h3 class="font-semibold text-gray-900 group-hover:text-ruby-dark transition-colors leading-snug">{card.title}</h3>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
      <p class="text-sm text-gray-700 leading-relaxed">
        <strong>Want the theory?</strong> The full series of eight long-form Scaling lessons lives at <a href="/scaling" class="text-ruby hover:text-ruby-dark font-medium">Scaling</a>. Each practice card here pairs with one of those.
      </p>
    </div>

    <div class="flex justify-between items-center pt-8 border-t border-gray-200">
      <a href="/practice" class="text-ruby hover:text-ruby-dark transition-colors">← Back to Practice</a>
      <span class="text-gray-400 text-sm">Practice · Scaling · 8 cards</span>
    </div>
  </article>
</Layout>
