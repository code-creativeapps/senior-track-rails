---
import Layout from '../../layouts/Layout.astro';

const cards = [
  { slug: 'practice-payments-no-idempotency',  emoji: '🔁', title: "What's the right idempotency key for this job?" },
  { slug: 'practice-payments-webhook-verify',  emoji: '🛡️', title: 'Why does this webhook controller skip CSRF?' },
  { slug: 'practice-payments-trust-redirect',  emoji: '🚨', title: 'Trusting the redirect: what goes wrong?' },
  { slug: 'practice-payments-event-ordering',  emoji: '🔀', title: 'Refunded event arrived first. Now what?' },
  { slug: 'practice-payments-refund-state',    emoji: '↩️', title: 'Modeling a partial refund: where does the data go?' },
  { slug: 'practice-payments-ledger-pick',     emoji: '📒', title: 'Wallet balance: column or ledger?' },
];
---

<Layout title="Payments — Practice" description="Multiple-choice drills on payment patterns: idempotency, webhook verification, async confirmation, refund modeling, event ordering, and the ledger pattern.">
  <article class="max-w-7xl mx-auto px-6 py-12 space-y-8">
    <div>
      <a href="/practice" class="text-ruby hover:text-ruby-dark transition-colors inline-flex items-center gap-2 mb-6">
        <span>←</span> Back to Practice
      </a>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Practice · Payments</p>
      <h1 class="text-4xl font-bold text-ruby-dark mb-4">Drill the payment patterns</h1>
      <p class="text-xl text-gray-600 leading-relaxed">One concrete payment scenario per card, four options to pick from. Wrong picks come with explanations — payments is the domain where wrong picks are most expensive.</p>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {cards.map((card, i) => (
        <a href={`/lessons/${card.slug}`} class="block bg-white rounded-lg border border-gray-200 p-5 hover:border-ruby/40 hover:shadow-md transition-all group">
          <div class="flex items-start gap-3">
            <span class="text-2xl" aria-hidden="true">{card.emoji}</span>
            <div class="flex-1">
              <p class="text-xs text-gray-500 mb-1 uppercase tracking-wider font-semibold">Card {i + 1}</p>
              <h3 class="font-semibold text-gray-900 group-hover:text-ruby-dark transition-colors leading-snug">{card.title}</h3>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-lg p-6">
      <p class="text-sm text-gray-700 leading-relaxed">
        <strong>Want the theory?</strong> The six long-form Payments lessons live at <a href="/payments" class="text-ruby hover:text-ruby-dark font-medium">Payments</a>.
      </p>
    </div>

    <div class="flex justify-between items-center pt-8 border-t border-gray-200">
      <a href="/practice" class="text-ruby hover:text-ruby-dark transition-colors">← Back to Practice</a>
      <span class="text-gray-400 text-sm">Practice · Payments · 6 cards</span>
    </div>
  </article>
</Layout>
