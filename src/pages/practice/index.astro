---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';

const categories = [
  {
    title: 'Spot the Tax',
    href: '/practice/spot-the-tax',
    count: '20 cards',
    icon: 'lucide:coins',
    summary: 'Code that works today and costs something specific in six months. Look at the snippet, predict the cost, reveal the principle. Reveal-only format.',
  },
  {
    title: 'Reading the Source',
    href: '/practice/reading-the-source',
    count: '5 cards',
    icon: 'lucide:search',
    summary: 'Multiple-choice drills on how Rails actually works behind the magic. Discrete answers, wrong picks explain themselves.',
  },
  {
    title: 'Scaling',
    href: '/practice/scaling',
    count: '8 cards',
    icon: 'lucide:trending-up',
    summary: 'One scaling-bug shape per card. Index design, N+1, caching, pagination, contention, concurrency, jobs, bulk operations.',
  },
  {
    title: 'SOLID',
    href: '/practice/solid',
    count: '10 cards',
    icon: 'lucide:puzzle',
    summary: 'Design-judgment cards, two per principle. The "answer" is a shape, not a discrete pick.',
  },
  {
    title: 'Payments',
    href: '/practice/payments',
    count: '6 cards',
    icon: 'lucide:credit-card',
    summary: 'The shapes that show up in real payment integrations: idempotency, webhook verification, async confirmation, refund modeling, event ordering, ledger picks.',
  },
  {
    title: 'Interview Prep',
    href: '/practice/interview',
    count: '6 cards',
    icon: 'lucide:mic',
    summary: 'Common senior Rails interview questions with answer rubrics. Each card explains what the right answer signals to the interviewer (and what the wrong ones do too).',
  },
];
---

<Layout title="Practice — Senior Track" description="Drill the theory until it sticks. Problem→reveal cards across six categories: Spot the Tax, Reading the Source, Scaling, SOLID, Payments, and Interview Prep. 55 cards total.">
  <article class="max-w-7xl mx-auto px-6 py-12 space-y-10">
    <div>
      <a href="/" class="text-ruby hover:text-ruby-dark transition-colors inline-flex items-center gap-2 mb-6">
        <span>←</span> Back to Course
      </a>
      <p class="text-sm uppercase tracking-wider text-ruby font-semibold mb-2">Senior Track</p>
      <h1 class="text-4xl font-bold text-ruby-dark mb-4">Practice</h1>
      <p class="text-xl text-gray-600 leading-relaxed">Theory teaches the shape. Practice makes it stick. Each card here is a short problem you commit to an answer on before any explanation appears — that commitment is what builds the senior reflex.</p>
    </div>

    <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
      <p class="text-sm text-gray-700 leading-relaxed">
        <strong>How to use Practice.</strong> Pick a category, look at the code or scenario, form an answer in your head, then reveal. The most valuable part is usually the breakdown of why the wrong picks were wrong. Coming back to the same cards weeks later is when the patterns stop feeling new.
      </p>
    </div>

    <div class="grid gap-5">
      {categories.map((cat) => (
        <a href={cat.href} class="block bg-white rounded-lg border border-gray-200 p-6 hover:border-ruby/40 hover:shadow-md transition-all group">
          <div class="flex items-start gap-4">
            <Icon name={cat.icon} class="w-10 h-10 inline-block" aria-hidden="true" />
            <div class="flex-1">
              <div class="flex items-baseline justify-between mb-2">
                <h2 class="text-xl font-bold text-gray-900 group-hover:text-ruby-dark transition-colors">{cat.title}</h2>
                <span class="text-sm text-gray-500">{cat.count}</span>
              </div>
              <p class="text-gray-700 leading-relaxed">{cat.summary}</p>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="flex justify-between items-center pt-8 border-t border-gray-200">
      <a href="/" class="text-ruby hover:text-ruby-dark transition-colors">← Back to Course</a>
      <span class="text-gray-400 text-sm">Senior Track · Practice · 55 cards</span>
    </div>
  </article>
</Layout>
