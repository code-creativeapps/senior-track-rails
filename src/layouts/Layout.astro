---
interface Props {
  title: string;
  description?: string;
  course?: string;
  /** Section label for breadcrumbs (e.g. "Hotwire", "Databases in Production"). */
  section?: string;
  /** Section URL slug for breadcrumbs (e.g. "/hotwire", "/databases"). */
  sectionHref?: string;
}

const { title, description, section, sectionHref } = Astro.props;

const fullTitle = `${title} | rails/learn`;
const desc = description || `${title} — rails/fullstack / learn, the senior track from railsfullstack.com.`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-image.svg', Astro.site).toString();
const siteOrigin = new URL('/', Astro.site).toString().replace(/\/$/, '');

const isLesson = Astro.url.pathname.startsWith('/lessons/');

// Auto-derive the section breadcrumb from the lesson slug so every lesson
// gets a Home → Section → Lesson trail without per-page configuration.
function inferSection(pathname: string): { name: string; href: string } | null {
  if (!pathname.startsWith('/lessons/')) return null;
  const slug = pathname.replace(/^\/lessons\//, '').replace(/\/$/, '');
  const rules: Array<[RegExp, { name: string; href: string }]> = [
    [/^hotwire-vs-/,                              { name: 'Hotwire',                 href: '/hotwire' }],
    [/^sidekiq-vs-solid-queue|^postgres-vs-/,     { name: 'rails/learn',             href: '/' }],
    [/^rails-8-features$|^best-rails-gems-|^modern-rails-stack-/, { name: '2026 Reference',  href: '/' }],
    [/^interview-question-/,                      { name: 'Interview Prep',          href: '/interview' }],
    [/^senior-hotwire-/,  { name: 'Hotwire',                 href: '/hotwire' }],
    [/^senior-db-/,       { name: 'Databases in Production', href: '/databases' }],
    [/^senior-scaling-/,  { name: 'Scaling Rails Apps',      href: '/scaling' }],
    [/^senior-(srp|ocp|lsp|isp|dip)-/, { name: 'SOLID',      href: '/solid' }],
    [/^senior-eager-loading$|^senior-glossary$|^senior-open-closed-/, { name: 'SOLID', href: '/solid' }],
    [/^source-/,          { name: 'Rails source code',       href: '/reading-the-source' }],
    [/^payments-/,        { name: 'Handling Payments',       href: '/payments' }],
    [/^interview-/,       { name: 'Interview Prep',          href: '/interview' }],
    [/^practice-/,        { name: 'Practice',                href: '/practice' }],
    [/^tax-|^spot-the-tax-/, { name: 'Spot the Tax',         href: '/practice/spot-the-tax' }],
  ];
  for (const [re, info] of rules) if (re.test(slug)) return info;
  return null;
}
const inferred = inferSection(Astro.url.pathname);
const resolvedSection     = section     ?? inferred?.name ?? null;
const resolvedSectionHref = sectionHref ?? inferred?.href ?? null;

// TechArticle schema for individual lesson pages. Google uses this for
// search-result enrichment (author, datePublished, breadcrumbs); LLM-based
// search engines lean on it for citation.
const articleSchema = isLesson ? {
  '@context':         'https://schema.org',
  '@type':            'TechArticle',
  headline:           title,
  description:        desc,
  author:             { '@type': 'Organization', name: 'rails/fullstack', url: 'https://railsfullstack.com' },
  publisher:          { '@type': 'Organization', name: 'rails/fullstack', url: 'https://railsfullstack.com' },
  mainEntityOfPage:   canonical,
  image:              ogImage,
  isAccessibleForFree: true,
  inLanguage:         'en',
} : null;

// BreadcrumbList: Home → (Section) → Lesson. Caller passes section + sectionHref;
// non-lesson pages render the homepage breadcrumb alone, which Google still uses
// for sitelinks generation.
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'rails/fullstack / learn', item: `${siteOrigin}/` },
];
if (resolvedSection && resolvedSectionHref) {
  breadcrumbItems.push({ '@type': 'ListItem', position: 2, name: resolvedSection, item: `${siteOrigin}${resolvedSectionHref}` });
}
if (isLesson) {
  breadcrumbItems.push({ '@type': 'ListItem', position: breadcrumbItems.length + 1, name: title, item: canonical });
}
const breadcrumbSchema = {
  '@context':       'https://schema.org',
  '@type':          'BreadcrumbList',
  itemListElement:  breadcrumbItems,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://rsms.me" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="rails/fullstack / learn" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Schema.org JSON-LD -->
    {articleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>
  <script>
    // OpenPanel analytics: page view on initial load, plus a one-shot
    // 'lesson_read_complete' event when the reader scrolls past 75% of a
    // lesson (proxy for "this person actually engaged with the content").
    import { trackPageView, trackEvent } from '../lib/openpanel';
    trackPageView();

    if (window.location.pathname.startsWith('/lessons/')) {
      let fired = false;
      const slug = window.location.pathname.replace(/^\/lessons\//, '').replace(/\/$/, '');
      window.addEventListener('scroll', () => {
        if (fired) return;
        const scrolled = window.scrollY + window.innerHeight;
        const total    = document.documentElement.scrollHeight;
        if (scrolled / total >= 0.75) {
          fired = true;
          trackEvent('lesson_read_complete', { slug });
        }
      }, { passive: true });
    }
  </script>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <header class="border-b border-black/[0.06] sticky top-0 z-50 bg-white">
      <nav class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between gap-6">
        <a href="/" class="font-semibold tracking-tight text-neutral-900 whitespace-nowrap">
          rails<span class="text-gum-pink">/</span>fullstack <span class="text-neutral-400 font-normal">/ learn</span>
        </a>
        <div class="hidden lg:flex items-center gap-5 text-sm">
          <a href="/practice" class="text-neutral-500 hover:text-neutral-900 transition-colors">Practice</a>
          <a href="/reading-the-source" class="text-neutral-500 hover:text-neutral-900 transition-colors">Rails source code</a>
          <a href="/solid" class="text-neutral-500 hover:text-neutral-900 transition-colors">SOLID</a>
          <a href="/scaling" class="text-neutral-500 hover:text-neutral-900 transition-colors">Scaling</a>
          <a href="/payments" class="text-neutral-500 hover:text-neutral-900 transition-colors">Payments</a>
          <a href="/interview" class="text-neutral-500 hover:text-neutral-900 transition-colors">Interview</a>
          <a href="/hotwire" class="text-neutral-500 hover:text-neutral-900 transition-colors">Hotwire</a>
          <a href="/databases" class="text-neutral-500 hover:text-neutral-900 transition-colors">Databases</a>
          <a href="https://railsfullstack.com" class="text-neutral-500 hover:text-gum-pink transition-colors whitespace-nowrap">
            Job board ↗
          </a>
        </div>
        <button
          id="nav-toggle"
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-9 h-9 -mr-2 rounded text-neutral-700 hover:bg-neutral-100 transition-colors"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <svg id="nav-icon-open"  class="w-5 h-5"        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="6"  x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="nav-icon-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="6" y1="18" x2="18" y2="6"/></svg>
        </button>
      </nav>
      <div id="mobile-nav" class="lg:hidden hidden border-t border-black/[0.06] bg-white">
        <div class="max-w-7xl mx-auto px-6 py-3 flex flex-col text-sm">
          <a href="/practice"            class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">Practice</a>
          <a href="/reading-the-source"  class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">Rails source code</a>
          <a href="/solid"               class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">SOLID</a>
          <a href="/scaling"             class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">Scaling</a>
          <a href="/payments"            class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">Payments</a>
          <a href="/interview"           class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">Interview</a>
          <a href="/hotwire"             class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">Hotwire</a>
          <a href="/databases"           class="py-2 text-neutral-700 hover:text-neutral-900 transition-colors">Databases</a>
          <a href="https://railsfullstack.com" class="py-2 text-neutral-700 hover:text-gum-pink transition-colors">Job board ↗</a>
        </div>
      </div>
    </header>
    <script>
      const toggle = document.getElementById('nav-toggle');
      const panel  = document.getElementById('mobile-nav');
      const iOpen  = document.getElementById('nav-icon-open');
      const iClose = document.getElementById('nav-icon-close');
      toggle?.addEventListener('click', () => {
        const open = panel?.classList.toggle('hidden') === false;
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        iOpen?.classList.toggle('hidden', open);
        iClose?.classList.toggle('hidden', !open);
      });
    </script>
    <main>
      <slot />
    </main>
    <footer class="bg-white border-t border-gray-200 mt-16">
      <div class="max-w-7xl mx-auto px-6 py-10 grid gap-8 md:grid-cols-3 text-sm">
        <div>
          <p class="font-semibold tracking-tight text-neutral-900 mb-2">
            rails<span class="text-gum-pink">/</span>fullstack <span class="text-neutral-400 font-normal">/ learn</span>
          </p>
          <p class="text-gray-500 leading-relaxed">
            The senior track for Rails developers. Free, no signup. Part of the railsfullstack family.
          </p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3">Elsewhere</p>
          <ul class="space-y-2 text-gray-600">
            <li>
              <a href="https://railsfullstack.com" class="hover:text-gum-pink transition-colors inline-flex items-center gap-1">
                railsfullstack.com <span class="text-gray-400">— Rails jobs</span>
              </a>
            </li>
            <li>
              <a href="https://blog.railsfullstack.com" class="hover:text-gum-pink transition-colors inline-flex items-center gap-1">
                blog.railsfullstack.com <span class="text-gray-400">— writing on the Rails ecosystem</span>
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/company/railsfullstack/" class="hover:text-gum-pink transition-colors">
                LinkedIn
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3">License</p>
          <p class="text-gray-500 leading-relaxed">
            Content licensed under <a href="https://creativecommons.org/licenses/by-nc/4.0/" class="underline hover:text-gum-pink">CC BY-NC 4.0</a>.<br />
            Code samples under Apache 2.0.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Match blog.railsfullstack.com: Inter variable font + the same
     OpenType feature toggles for slashed zero / alt characters. */
  html {
    font-feature-settings: 'cv11', 'ss01', 'ss03';
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: 'Inter var', 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }

  code {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }
</style>
