---
interface Props {
  title: string;
  description?: string;
  course?: string;
}

const { title, description } = Astro.props;

const fullTitle = `${title} | Senior Track — RailsFullStack`;
const desc = description || `${title} — Senior Track for Rails developers.`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-image.svg', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Senior Track — RailsFullStack" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <nav class="max-w-4xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="text-2xl font-bold text-ruby hover:text-ruby-dark transition-colors">
            Senior Track
          </a>
          <div class="flex items-center gap-6 text-sm">
            <a href="/practice" class="text-gray-600 hover:text-gray-900 transition-colors">Practice</a>
            <a href="/reading-the-source" class="text-gray-600 hover:text-gray-900 transition-colors">Reading the Source</a>
            <a href="/solid" class="text-gray-600 hover:text-gray-900 transition-colors">SOLID</a>
            <a href="/scaling" class="text-gray-600 hover:text-gray-900 transition-colors">Scaling</a>
          </div>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bg-white border-t border-gray-200 mt-16">
      <div class="max-w-4xl mx-auto px-6 py-8">
        <p class="text-sm text-gray-500 text-center">
          Senior Track — RailsFullStack<br />
          Content Licensed Under CC-BY-NC-4.0 · Code Samples Under Apache 2.0
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    line-height: 1.6;
  }

  code {
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    font-size: 0.9em;
  }
</style>
