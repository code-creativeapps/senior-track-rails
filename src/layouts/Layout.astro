---
interface Props {
  title: string;
  description?: string;
  course?: string;
}

const { title, description } = Astro.props;

const fullTitle = `${title} | rails/fullstack / learn`;
const desc = description || `${title} — rails/fullstack / learn, the senior track from railsfullstack.com.`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/og-image.svg', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://rsms.me" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="rails/fullstack / learn" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <header class="border-b border-black/[0.06] sticky top-0 z-50 bg-white">
      <nav class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between gap-6">
        <a href="/" class="font-semibold tracking-tight text-neutral-900 whitespace-nowrap">
          rails<span class="text-gum-pink">/</span>fullstack <span class="text-neutral-400 font-normal">/ learn</span>
        </a>
        <div class="flex items-center gap-5 text-sm">
          <a href="/practice" class="text-neutral-500 hover:text-neutral-900 transition-colors">Practice</a>
          <a href="/reading-the-source" class="text-neutral-500 hover:text-neutral-900 transition-colors">Rails source code</a>
          <a href="/solid" class="text-neutral-500 hover:text-neutral-900 transition-colors">SOLID</a>
          <a href="/scaling" class="text-neutral-500 hover:text-neutral-900 transition-colors">Scaling</a>
          <a href="/payments" class="text-neutral-500 hover:text-neutral-900 transition-colors">Payments</a>
          <a href="/interview" class="text-neutral-500 hover:text-neutral-900 transition-colors">Interview</a>
          <a href="/hotwire" class="text-neutral-500 hover:text-neutral-900 transition-colors">Hotwire</a>
          <a href="https://railsfullstack.com" class="text-neutral-500 hover:text-gum-pink transition-colors whitespace-nowrap">
            Job board ↗
          </a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bg-white border-t border-gray-200 mt-16">
      <div class="max-w-7xl mx-auto px-6 py-10 grid gap-8 md:grid-cols-3 text-sm">
        <div>
          <p class="font-semibold tracking-tight text-neutral-900 mb-2">
            rails<span class="text-gum-pink">/</span>fullstack <span class="text-neutral-400 font-normal">/ learn</span>
          </p>
          <p class="text-gray-500 leading-relaxed">
            The senior track for Rails developers. Free, no signup. Part of the railsfullstack family.
          </p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3">Elsewhere</p>
          <ul class="space-y-2 text-gray-600">
            <li>
              <a href="https://railsfullstack.com" class="hover:text-gum-pink transition-colors inline-flex items-center gap-1">
                railsfullstack.com <span class="text-gray-400">— Rails jobs</span>
              </a>
            </li>
            <li>
              <a href="https://blog.railsfullstack.com" class="hover:text-gum-pink transition-colors inline-flex items-center gap-1">
                blog.railsfullstack.com <span class="text-gray-400">— writing on the Rails ecosystem</span>
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/company/railsfullstack/" class="hover:text-gum-pink transition-colors">
                LinkedIn
              </a>
            </li>
          </ul>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-gray-400 font-semibold mb-3">License</p>
          <p class="text-gray-500 leading-relaxed">
            Content licensed under <a href="https://creativecommons.org/licenses/by-nc/4.0/" class="underline hover:text-gum-pink">CC BY-NC 4.0</a>.<br />
            Code samples under Apache 2.0.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Match blog.railsfullstack.com: Inter variable font + the same
     OpenType feature toggles for slashed zero / alt characters. */
  html {
    font-feature-settings: 'cv11', 'ss01', 'ss03';
    -webkit-text-size-adjust: 100%;
  }

  body {
    font-family: 'Inter var', 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }

  code {
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }
</style>
